<mxCell id="c17" value="&lt;b&gt;Public open data&lt;/b&gt;" style="rounded=1;arcSize=3;container=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=none;strokeColor=#666666;strokeWidth=1;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="116" width="220" height="480" as="geometry"/></mxCell>
<mxCell id="c18" value="&lt;b&gt;Luchtmeetnet API&lt;/b&gt;&lt;br&gt;Station NL10240&lt;br&gt;Hourly NO₂ averages" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="185" width="180" height="90" as="geometry"/></mxCell>
<mxCell id="c19" value="&lt;b&gt;NDW open data&lt;/b&gt;&lt;br&gt;4 sites at the A27&lt;br&gt;One-minute counts" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="465" width="180" height="90" as="geometry"/></mxCell>
<mxCell id="c20" value="&lt;b&gt;Developer laptop: Docker Compose&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Private network airbreda&lt;/font&gt;" style="rounded=1;arcSize=3;container=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=none;strokeColor=#666666;strokeWidth=1;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="310" y="116" width="610" height="480" as="geometry"/></mxCell>
<mxCell id="c21" value="&lt;b&gt;air-ingest&lt;/b&gt;&lt;br&gt;ingest_air.py, hourly loop&lt;br&gt;Flags null and stale NO₂&lt;br&gt;/health on port 8001" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="175" width="230" height="110" as="geometry"/></mxCell>
<mxCell id="c22" value="&lt;b&gt;JSON logs&lt;/b&gt;&lt;br&gt;stdout, one line&lt;br&gt;per event&lt;br&gt;INFO, WARNING,&lt;br&gt;ERROR" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="305" width="170" height="130" as="geometry"/></mxCell>
<mxCell id="c23" value="&lt;b&gt;traffic-ingest&lt;/b&gt;&lt;br&gt;ingest_traffic.py, hourly loop&lt;br&gt;Skips speed = -1&lt;br&gt;/health on port 8002" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="455" width="230" height="110" as="geometry"/></mxCell>
<mxCell id="c24" value="&lt;b&gt;redis (redis:7-alpine)&lt;/b&gt;&lt;br&gt;List: readings&lt;br&gt;In memory, no persistence&lt;br&gt;No consumer yet" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="330" width="200" height="100" as="geometry"/></mxCell>
<mxCell id="c25" value="&lt;b&gt;Microsoft Azure: Italy North&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Resource group airbreda-rg&lt;/font&gt;" style="rounded=1;arcSize=3;container=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=none;strokeColor=#6c8ebf;strokeWidth=1;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="960" y="116" width="500" height="480" as="geometry"/></mxCell>
<mxCell id="c26" value="&lt;b&gt;Azure Database for PostgreSQL&lt;/b&gt;&lt;br&gt;Table sensor_readings&lt;br&gt;NO₂ rows with is_flagged&lt;br&gt;Traffic flow and speed rows" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="170" width="320" height="140" as="geometry"/></mxCell>
<mxCell id="c27" value="&lt;b&gt;Azure Blob Storage (LRS)&lt;/b&gt;&lt;br&gt;Container airbreda-raw&lt;br&gt;One CSV per site per hour" style="shape=folder;tabWidth=46;tabHeight=12;tabPosition=left;spacingTop=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="455" width="320" height="120" as="geometry"/></mxCell>
<mxCell id="c37" value="&lt;b&gt;Luchtmeetnet: flag and keep&lt;/b&gt;&lt;br&gt;Null, or unchanged for 3+ hours: row kept&lt;br&gt;with is_flagged = TRUE and one WARNING&lt;br&gt;DATA_QUALITY_ERROR per row." style="shape=note;size=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="626" width="340" height="100" as="geometry"/></mxCell>
<mxCell id="c38" value="&lt;b&gt;NDW: skip the speed row&lt;/b&gt;&lt;br&gt;speed = -1: speed row not written; flow&lt;br&gt;row and bucket file kept; WARNING logged.&lt;br&gt;More than 10 in an hour: one ERROR." style="shape=note;size=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="400" y="626" width="340" height="100" as="geometry"/></mxCell>
<mxCell id="c39" value="&lt;b&gt;Log levels&lt;/b&gt;&lt;br&gt;INFO: fetch_success, db_write_success,&lt;br&gt;publish_success. WARNING: data quality,&lt;br&gt;fetch_retry. ERROR: failed writes." style="shape=note;size=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="760" y="626" width="340" height="100" as="geometry"/></mxCell>
<mxCell id="c40" value="&lt;b&gt;Queue alongside direct writes&lt;/b&gt;&lt;br&gt;54 messages per run (50 NO₂, 4 NDW).&lt;br&gt;Not guaranteed to survive a restart;&lt;br&gt;the database stays the system of record." style="shape=note;size=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1120" y="626" width="340" height="100" as="geometry"/></mxCell>
<mxCell id="c28" value="HTTPS, JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=11;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
