<mxCell id="c14" value="&lt;b&gt;Luchtmeetnet API (RIVM)&lt;/b&gt;&lt;br&gt;Station NL10240&lt;br&gt;Breda-Tilburgseweg&lt;br&gt;Hourly NO₂ averages" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="190" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="c15" value="&lt;b&gt;NDW open data&lt;/b&gt;&lt;br&gt;National traffic feed&lt;br&gt;4 sites at the A27 interchange&lt;br&gt;One-minute measurements" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="450" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="c16" value="&lt;b&gt;Developer laptop&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Docker Desktop&lt;/font&gt;" style="rounded=1;arcSize=3;container=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=none;strokeColor=#666666;strokeWidth=1;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="390" y="116" width="320" height="500" as="geometry"/></mxCell>
<mxCell id="c17" value="&lt;b&gt;airbreda-air&lt;/b&gt;&lt;br&gt;ingest_air.py&lt;br&gt;Fetch and filter NO₂&lt;br&gt;Retry with backoff" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="440" y="190" width="220" height="90" as="geometry"/></mxCell>
<mxCell id="c18" value="&lt;b&gt;airbreda-traffic&lt;/b&gt;&lt;br&gt;ingest_traffic.py&lt;br&gt;Parse 4 sites: total flow&lt;br&gt;and average speed" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="440" y="450" width="220" height="90" as="geometry"/></mxCell>
<mxCell id="c19" value="&lt;b&gt;Microsoft Azure: Italy North&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Resource group airbreda-rg&lt;/font&gt;" style="rounded=1;arcSize=3;container=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=none;strokeColor=#6c8ebf;strokeWidth=1;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="830" y="116" width="530" height="500" as="geometry"/></mxCell>
<mxCell id="c20" value="&lt;b&gt;Azure Database for PostgreSQL&lt;/b&gt;&lt;br&gt;Flexible Server, Burstable B1ms&lt;br&gt;Table sensor_readings&lt;br&gt;Key: station, timestamp, component" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="170" width="280" height="130" as="geometry"/></mxCell>
<mxCell id="c21" value="&lt;b&gt;Azure Blob Storage (LRS)&lt;/b&gt;&lt;br&gt;Account airbredaraya&lt;br&gt;Private container airbreda-raw&lt;br&gt;ndw/YYYY-MM-DD/HH-site.csv" style="shape=folder;tabWidth=46;tabHeight=12;tabPosition=left;spacingTop=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="430" width="280" height="130" as="geometry"/></mxCell>
<mxCell id="c26" value="&lt;b&gt;At-least-once, idempotent writes&lt;/b&gt;&lt;br&gt;Luchtmeetnet repeats 50 hours on every call;&lt;br&gt;the primary key and file overwrites absorb duplicates." style="shape=note;size=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="644" width="420" height="82" as="geometry"/></mxCell>
<mxCell id="c27" value="&lt;b&gt;Collected only while the laptop is on&lt;/b&gt;&lt;br&gt;NDW only shows current traffic, so hours&lt;br&gt;missed while the laptop is off are lost." style="shape=note;size=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="490" y="644" width="420" height="82" as="geometry"/></mxCell>
<mxCell id="c28" value="&lt;b&gt;Credentials at this stage&lt;/b&gt;&lt;br&gt;Database admin login and storage connection&lt;br&gt;string, read from a local .env (never committed)." style="shape=note;size=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="940" y="644" width="420" height="82" as="geometry"/></mxCell>
<mxCell id="c22" value="HTTPS, JSON&lt;br&gt;last 50 hours" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=11;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c23" value="HTTP, XML.gz&lt;br&gt;national snapshot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=11;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c24" value="INSERT ... ON CONFLICT&lt;br&gt;DO NOTHING" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=11;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c25" value="One CSV per site&lt;br&gt;per hour (overwrite)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=11;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
