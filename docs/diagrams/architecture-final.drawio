<mxCell id="c24" value="&lt;b&gt;NSG&lt;/b&gt;&lt;br&gt;TCP 8000: dashboard&lt;br&gt;TCP 22: developer IP&lt;br&gt;Everything else&lt;br&gt;denied" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="480" width="130" height="120" as="geometry"/></mxCell>
<mxCell id="c25" value="&lt;b&gt;airbreda-vm&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Standard_B2ats_v2, Ubuntu 24.04 LTS&lt;/font&gt;" style="rounded=1;arcSize=3;container=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#f7fbff;strokeColor=#6c8ebf;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="500" y="200" width="560" height="476" as="geometry"/></mxCell>
<mxCell id="c26" value="&lt;b&gt;Managed identity&lt;/b&gt;&lt;br&gt;system-assigned" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="212" width="145" height="46" as="geometry"/></mxCell>
<mxCell id="c27" value="&lt;b&gt;Docker network airbreda&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Health ports internal only&lt;/font&gt;" style="rounded=1;arcSize=3;container=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=none;strokeColor=#6c8ebf;strokeWidth=1;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="515" y="270" width="270" height="396" as="geometry"/></mxCell>
<mxCell id="c28" value="&lt;b&gt;air-ingest&lt;/b&gt;&lt;br&gt;Hourly loop&lt;br&gt;/health on 127.0.0.1:8001" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="530" y="320" width="240" height="84" as="geometry"/></mxCell>
<mxCell id="c29" value="&lt;b&gt;traffic-ingest&lt;/b&gt;&lt;br&gt;Hourly loop&lt;br&gt;/health on 127.0.0.1:8002" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="530" y="440" width="240" height="84" as="geometry"/></mxCell>
<mxCell id="c30" value="&lt;b&gt;dashboard (FastAPI, port 8000)&lt;/b&gt;&lt;br&gt;/site/{id}, /health, /history,&lt;br&gt;/model and the page&lt;br&gt;model.pkl baked in, non-root" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="530" y="556" width="240" height="100" as="geometry"/></mxCell>
<mxCell id="c31" value="&lt;b&gt;Italy North&lt;/b&gt;" style="rounded=1;arcSize=3;container=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=none;strokeColor=#6c8ebf;strokeWidth=1;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1110" y="170" width="530" height="526" as="geometry"/></mxCell>
<mxCell id="c32" value="&lt;b&gt;Azure Database for PostgreSQL&lt;/b&gt;&lt;br&gt;Burstable B1ms, sensor_readings&lt;br&gt;Firewall: VM IP, developer IP&lt;br&gt;Azure-services access off" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1170" y="215" width="320" height="160" as="geometry"/></mxCell>
<mxCell id="c33" value="&lt;b&gt;Azure Blob Storage (LRS)&lt;/b&gt;&lt;br&gt;Container airbreda-raw&lt;br&gt;VM: managed identity (role)&lt;br&gt;Laptop: account key (training)" style="shape=folder;tabWidth=46;tabHeight=12;tabPosition=left;spacingTop=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1170" y="460" width="320" height="140" as="geometry"/></mxCell>
<mxCell id="c43" value="&lt;b&gt;Developer laptop&lt;/b&gt;" style="rounded=1;arcSize=3;container=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=none;strokeColor=#666666;strokeWidth=1;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="746" width="560" height="170" as="geometry"/></mxCell>
<mxCell id="c44" value="&lt;b&gt;Developer&lt;/b&gt;&lt;br&gt;SSH key" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="160" y="772" width="30" height="54" as="geometry"/></mxCell>
<mxCell id="c45" value="&lt;b&gt;Training and release&lt;/b&gt;&lt;br&gt;(admin login, storage key)&lt;br&gt;build_training_data.py: NO₂ (DB) + traffic (bucket)&lt;br&gt;train_model.py: LinearRegression, model.pkl&lt;br&gt;pytest, then git push" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="215" y="772" width="365" height="124" as="geometry"/></mxCell>
<mxCell id="c46" value="&lt;b&gt;GitHub repository&lt;/b&gt;&lt;br&gt;Code, tests, model.pkl,&lt;br&gt;model_metrics.json&lt;br&gt;No secrets" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="772" width="240" height="124" as="geometry"/></mxCell>
<mxCell id="c50" value="&lt;b&gt;Trust boundaries&lt;/b&gt;&lt;br&gt;Internet to VM: only TCP 8000 (dashboard)&lt;br&gt;and TCP 22 (developer IP only).&lt;br&gt;VM to storage: managed identity on one&lt;br&gt;container. VM to database: two users, one&lt;br&gt;read-only. Laptop: admin login and storage&lt;br&gt;key, for setup and training only." style="shape=note;size=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="920" y="746" width="360" height="170" as="geometry"/></mxCell>
<mxCell id="c51" value="&lt;b&gt;Operations&lt;/b&gt;&lt;br&gt;All containers: --restart unless-stopped,&lt;br&gt;Docker starts at boot; reboot tested.&lt;br&gt;Model is baked into the image: retrain,&lt;br&gt;commit, then rebuild the dashboard.&lt;br&gt;Logs: structured JSON, rotated 3 x 10 MB." style="shape=note;size=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1300" y="746" width="360" height="170" as="geometry"/></mxCell>
