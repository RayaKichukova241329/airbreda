<mxCell id="c24" value="&lt;b&gt;NSG&lt;/b&gt;&lt;br&gt;Inbound: SSH 22&lt;br&gt;from developer IP&lt;br&gt;Everything else denied" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="500" width="120" height="80" as="geometry"/></mxCell>
<mxCell id="c25" value="&lt;b&gt;airbreda-vm&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Standard_B2ats_v2, Ubuntu 24.04 LTS&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Docker, 2 GB swap, log rotation&lt;/font&gt;" style="rounded=1;arcSize=3;container=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#f7fbff;strokeColor=#6c8ebf;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="480" y="200" width="460" height="436" as="geometry"/></mxCell>
<mxCell id="c26" value="&lt;b&gt;Managed identity&lt;/b&gt;&lt;br&gt;system-assigned" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790" y="210" width="135" height="46" as="geometry"/></mxCell>
<mxCell id="c27" value="&lt;b&gt;air-ingest&lt;/b&gt;&lt;br&gt;Hourly loop, restart unless-stopped&lt;br&gt;/health on 127.0.0.1:8001" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="510" y="280" width="240" height="100" as="geometry"/></mxCell>
<mxCell id="c28" value="&lt;b&gt;traffic-ingest&lt;/b&gt;&lt;br&gt;Hourly loop, restart unless-stopped&lt;br&gt;/health on 127.0.0.1:8002" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="510" y="440" width="240" height="100" as="geometry"/></mxCell>
<mxCell id="c29" value="&lt;b&gt;Italy North&lt;/b&gt;" style="rounded=1;arcSize=3;container=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=none;strokeColor=#6c8ebf;strokeWidth=1;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="990" y="170" width="550" height="486" as="geometry"/></mxCell>
<mxCell id="c30" value="&lt;b&gt;Azure Database for PostgreSQL&lt;/b&gt;&lt;br&gt;Burstable B1ms, table sensor_readings&lt;br&gt;Firewall: VM IP only&lt;br&gt;Azure-services access off" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1060" y="205" width="330" height="175" as="geometry"/></mxCell>
<mxCell id="c31" value="&lt;b&gt;Azure Blob Storage (LRS)&lt;/b&gt;&lt;br&gt;Container airbreda-raw&lt;br&gt;Access by role assignment only" style="shape=folder;tabWidth=46;tabHeight=12;tabPosition=left;spacingTop=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1060" y="455" width="330" height="120" as="geometry"/></mxCell>
<mxCell id="c39" value="&lt;b&gt;Region constraint&lt;/b&gt;&lt;br&gt;No free B-series VM size was available in&lt;br&gt;Italy North: the VM runs in Poland Central;&lt;br&gt;database and storage stay in Italy North." style="shape=note;size=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="706" width="365" height="100" as="geometry"/></mxCell>
<mxCell id="c40" value="&lt;b&gt;Always-on containers&lt;/b&gt;&lt;br&gt;Hourly loop with --restart unless-stopped&lt;br&gt;instead of cron, so the /health state survives.&lt;br&gt;A reboot test confirmed automatic recovery." style="shape=note;size=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="425" y="706" width="365" height="100" as="geometry"/></mxCell>
<mxCell id="c41" value="&lt;b&gt;Least privilege&lt;/b&gt;&lt;br&gt;Identity scoped to the airbreda-raw container,&lt;br&gt;database user without DELETE or DROP,&lt;br&gt;.env only on the VM, permissions 600." style="shape=note;size=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="810" y="706" width="365" height="100" as="geometry"/></mxCell>
<mxCell id="c42" value="&lt;b&gt;Redis removed (ADR-004)&lt;/b&gt;&lt;br&gt;One VM and no second consumer: the queue&lt;br&gt;added nothing, so ingestion writes directly&lt;br&gt;to the database and the bucket." style="shape=note;size=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1195" y="706" width="365" height="100" as="geometry"/></mxCell>
