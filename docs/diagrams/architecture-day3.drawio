<mxCell id="c22" value="&lt;b&gt;Microsoft Azure (Azure for Students)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Resource group airbreda-rg&lt;/font&gt;" style="rounded=1;arcSize=3;container=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=none;strokeColor=#6c8ebf;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="300" y="116" width="1260" height="560" as="geometry"/></mxCell>
