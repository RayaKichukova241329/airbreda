FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends redis-tools \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN pip install --no-cache-dir pandas psycopg2-binary azure-storage-blob azure-identity python-dotenv redis
COPY common.py getTrafficReadings.py ingest_traffic.py ./
CMD ["python", "ingest_traffic.py"]